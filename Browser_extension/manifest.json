{
  "manifest_version": 3,
  "name": "KeyVault",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "description": "本地密钥保管箱 KeyVault 的浏览器端：网页复制的密钥本地检测入库，剪贴板 30 秒自动擦除，数据不出本机。",
  "permissions": ["storage", "alarms", "clipboardWrite", "offscreen"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "KeyVault"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  }
}
