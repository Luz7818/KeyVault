{
  "manifest_version": 3,
  "name": "KeyVault",
  "version": "0.3.0",
  "description": "独立本地密钥保管箱：网页复制的 key 自动检测、像保存密码一样确认入库，浏览器内全功能管理。加密数据只存本机浏览器。",
  "permissions": ["storage", "alarms", "clipboardWrite", "offscreen"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "KeyVault"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  }
}
