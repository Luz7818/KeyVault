{"id": "gcp-service-account-json-is-one-record", "input": "{\"type\":\"service_account\",\"project_id\":\"my-proj\",\"private_key_id\":\"abc123def\",\"private_key\":\"-----BEGIN PRIVATE KEY-----\\n<合成 200 字符 base64>\\n-----END PRIVATE KEY-----\\n\",\"client_email\":\"sa@my-proj.iam.gserviceaccount.com\",\"token_uri\":\"https://oauth2.googleapis.com/token\"}", "expect": "accepted", "expect_count": 1, "expect_kind": "json", "expect_platform": "google", "expect_confidence": "exact", "expect_extra_has": "project_id"}
{"id": "gcp-json-is-not-split-into-rows", "input": "{\"type\":\"service_account\",\"project_id\":\"p\",\"private_key\":\"-----BEGIN PRIVATE KEY-----\\n<合成 200 字符 base64>\\n-----END PRIVATE KEY-----\\n\",\"client_email\":\"a@p.iam.gserviceaccount.com\"}", "expect": "accepted", "expect_count": 1}
{"id": "aws-credentials-csv-is-a-pair", "input": "User name,Access key ID,Secret access key\ndeploy,AKIA<16位大写>,<40位字母数字>", "expect": "accepted", "expect_count": 2, "expect_pair": true}
{"id": "dotenv-block-multiline", "input": "A=1\nOPENAI_API_KEY=sk-<48位合成>\n# 这是注释\nGITLAB_TOKEN=glpat-<20位字母数字>", "expect": "accepted", "expect_count": 2, "expect_platforms": ["gitlab", "openai"]}
{"id": "dotenv-export-prefix-and-quotes", "input": "export DEEPSEEK_API_KEY=\"sk-<48位合成>\"\nexport GITHUB_TOKEN='ghp_<36位字母数字>'", "expect": "accepted", "expect_count": 2, "expect_platforms": ["deepseek", "github"]}
{"id": "dotenv-comment-hash-inside-quotes-survives", "input": "SLACK_TOKEN=\"xoxb-<20位字母数字>\" # 机器人令牌", "expect": "accepted", "expect_count": 1, "expect_platform": "slack"}
{"id": "dotenv-crlf-line-endings", "input": "DEEPSEEK_API_KEY=sk-<48位合成>\r\nGITHUB_TOKEN=ghp_<36位字母数字>\r\n", "expect": "accepted", "expect_count": 2}
{"id": "curl-multiline-backslash-continuation", "input": "curl https://api.deepseek.com/v1/chat/completions \\\n  -H 'Content-Type: application/json' \\\n  -H 'Authorization: Bearer sk-<48位合成>' \\\n  -d '{\"model\":\"deepseek-chat\"}'", "expect": "accepted", "expect_count": 1, "expect_platform": "deepseek", "expect_confidence": "exact"}
{"id": "curl-powershell-backtick-continuation", "input": "curl https://api.moonshot.cn/v1/chat/completions `\n  -H \"Authorization: Bearer sk-<48位合成>\"", "expect": "accepted", "expect_count": 1, "expect_platform": "moonshot", "expect_confidence": "exact"}
{"id": "curl-does-not-treat-content-type-as-a-secret", "input": "curl https://api.openai.com/v1/models -H 'Content-Type: application/json' -H 'Accept: application/json'", "expect": "rejected"}
{"id": "json-embedded-in-prose", "input": "配置是这样 {\"api_key\":\"sk-<48位合成>\",\"base_url\":\"https://api.siliconflow.cn/v1\"} 存好的", "expect": "accepted", "expect_count": 1, "expect_platform": "siliconflow", "expect_confidence": "exact"}
{"id": "json-list-of-records", "input": "[{\"api_key\":\"sk-<48位合成>\",\"base_url\":\"https://api.deepseek.com/v1\"},{\"api_key\":\"ghp_<36位字母数字>\"}]", "expect": "accepted", "expect_count": 2, "expect_platforms": ["deepseek", "github"]}
{"id": "key-found-in-prose-by-generic-scan", "input": "我的令牌是 ghp_<36位字母数字> 别告诉别人", "expect": "accepted", "expect_count": 1, "expect_platform": "github"}
{"id": "same-value-under-two-key-names-both-surface", "input": "DEEPSEEK_API_KEY=sk-<48位合成>\nDEEPSEEK_API_KEY_COPY=sk-<48位合成>", "expect": "accepted", "expect_count": 2}
{"id": "identical-key-and-name-dedupes-at-parse", "input": "DEEPSEEK_API_KEY=sk-<48位合成>\nDEEPSEEK_API_KEY=sk-<48位合成>", "expect": "accepted", "expect_count": 1}
